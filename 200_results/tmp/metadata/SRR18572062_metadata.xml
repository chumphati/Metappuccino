<EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX14701158" alias="GSM5994496_r1"><IDENTIFIERS><PRIMARY_ID>SRX14701158</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM5994496_r1</EXTERNAL_ID></IDENTIFIERS><TITLE>GSM5994496: SmaC1C; Homo sapiens; RNA-Seq</TITLE><STUDY_REF accession="SRP366999"><IDENTIFIERS><PRIMARY_ID>SRP366999</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA819837</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS16495835"><IDENTIFIERS><PRIMARY_ID>SRS16495835</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN27020239</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>GSM5994496</LIBRARY_NAME><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>IPF patients were diagnosed based on                     multidisciplinary review and published criteria. Non-IPF donor lungs not                     suitable for transplantation were obtained from the Regional Organ Bank of                     Illinois. IPF lungs were grossly examined within 6-12 hours from the time of                     explant, and multiple 1cm3 biopsies were obtained from visibly non-fibrotic                     central (IPF.C) and fibrotic peripheral (IPF.P) areas. Non-IPF donor lung                     biopsies of central (CTR.C) and peripheral (CTR.P) were similarly obtained.                     H&amp;E-stained biopsies were reviewed and confirmed by two clinical                     pathologists Total RNA was isolated using TRIzol (Invitrogen) following                     manufacturer's protocol. All RNA samples displayed RNA Integrity Number (RIN)                     &gt;7. RNAseq including cDNA library preparation was processed at the Genomics                     Core Facility of University of Chicago (https://fgf.uchicago.edu/). Total RNA in                     the amount of 100-500µg per sample was depleted of ribosomal RNA using the                     Ribo-Zero kit (Epicentre, Madison, WI). The directional (first strand) cDNA                     libraries were prepared following the guide of TruSeq Stranded Total RNA Sample                     Preparation kit.</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 4000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="" center_name="Medicine, University of Viginia" accession="SRA1395994" alias="SUB11267531"><IDENTIFIERS><PRIMARY_ID>SRA1395994</PRIMARY_ID><SUBMITTER_ID namespace="Medicine, University of Viginia">SUB11267531</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Medicine, University of Viginia</Name><Contact email="yh9fj@virginia.edu"><Address><Street>1340 Jefferson Park Ave</Street><City>Charlottesville</City><Sub>VA</Sub><Country>USA</Country></Address><Name><First>Yong</First><Last>Huang</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA819837" accession="SRP366999"><IDENTIFIERS><PRIMARY_ID>SRP366999</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA819837</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Homo sapiens Raw sequence reads</STUDY_TITLE><STUDY_TYPE existing_study_type="Whole Genome Sequencing"/><STUDY_ABSTRACT>NA</STUDY_ABSTRACT><CENTER_PROJECT_NAME>Homo sapiens</CENTER_PROJECT_NAME></DESCRIPTOR></STUDY><SAMPLE alias="SmaC1C" accession="SRS16495835"><IDENTIFIERS><PRIMARY_ID>SRS16495835</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN27020239</EXTERNAL_ID><SUBMITTER_ID namespace="pda|yongh" label="Sample name">SmaC1C</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>9606</TAXON_ID><SCIENTIFIC_NAME>Homo sapiens</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>819837</ID><LABEL>PRJNA819837</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE