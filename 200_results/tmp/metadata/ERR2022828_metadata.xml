s required. Multiplex library pools were created by mixing equal amounts of 5 pre-capture sample libraries and capture hybridization performed on 1 μg of the pooled library. Melanoma A-series samples were each randomly assigned to one of three capture hybridizations to ensure any expression differences between the A and C-series samples were not due to an A-series batch effect. Post-capture LMPCR was performed for 17 cycles.</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR><SPOT_DESCRIPTOR><SPOT_DECODE_SPEC><SPOT_LENGTH>40</SPOT_LENGTH><READ_SPEC><READ_INDEX>0</READ_INDEX><READ_LABEL>F</READ_LABEL><READ_CLASS>Application Read</READ_CLASS><READ_TYPE>Forward</READ_TYPE><BASE_COORD>1</BASE_COORD></READ_SPEC><READ_SPEC><READ_INDEX>1</READ_INDEX><READ_LABEL>R</READ_LABEL><READ_CLASS>Application Read</READ_CLASS><READ_TYPE>Reverse</READ_TYPE><BASE_COORD>21</BASE_COORD></READ_SPEC></SPOT_DECODE_SPEC></SPOT_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA xmlns:com="SRA.common"><INSTRUMENT_MODEL>Illumina HiSeq 2000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_ATTRIBUTES xmlns:com="SRA.common"><EXPERIMENT_ATTRIBUTE><TAG>Experimental Factor: organism part</TAG><VALUE>brain</VALUE></EXPERIMENT_ATTRIBUTE><EXPERIMENT_ATTRIBUTE><TAG>Experimental Factor: disease</TAG><VALUE>normal</VALUE></EXPERIMENT_ATTRIBUTE><EXPERIMENT_ATTRIBUTE><TAG>Experimental Factor: cell line</TAG><VALUE>not applicable</VALUE></EXPERIMENT_ATTRIBUTE><EXPERIMENT_ATTRIBUTE><TAG>Experimental Factor: stimulus</TAG><VALUE>none</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="E-MTAB-4519J6" broker_name="ArrayExpress" accession="ERA970676" lab_name="European Nucleotide Archive"><IDENTIFIERS><PRIMARY_ID>ERA970676</PRIMARY_ID><SUBMITTER_ID namespace="GARVAN INSTITUTE OF MEDICAL RESEARCH">E-MTAB-4519J6</SUBMITTER_ID><SUBMITTER_ID namespace="Garvan Institute of Medical Research">E-MTAB-4519J6</SUBMITTER_ID></IDENTIFIERS><TITLE>Submitted by GARVAN INSTITUTE OF MEDICAL RESEARCH on 0