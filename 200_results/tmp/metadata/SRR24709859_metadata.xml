<EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX20488513" alias="GSM7418754_r1"><IDENTIFIERS><PRIMARY_ID>SRX20488513</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM7418754_r1</EXTERNAL_ID></IDENTIFIERS><TITLE>GSM7418754: S037,Basilic vein,Healthy,NA; Homo sapiens; RNA-Seq</TITLE><STUDY_REF accession="SRP439183"><IDENTIFIERS><PRIMARY_ID>SRP439183</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA975585</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS17799250"><IDENTIFIERS><PRIMARY_ID>SRS17799250</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM7418754</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>GSM7418754</LIBRARY_NAME><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>RNAlater-preserved samples were ground in liquid nitrogen and isolated with Trizol (Thermo Fisher Scientific) followed by column purification (EZNA Total RNA Kit I, Omega Bio-tek). 500 ng of total RNA was used as input for the Illumina TruSeq Stranded Total RNA Library Prep Kit with Ribo-Zero to generate ribosomal RNA-depleted sequencing libraries. Each sample had a unique barcode to allow multiplexing, and was sequenced to &gt;40 million raw reads in a single end 75 bp sequencing run on the Illumina NextSeq500.</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>NextSeq 500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="" center_name="University of Miami" accession="SRA1643145" alias="SUB13452385"><IDENTIFIERS><PRIMARY_ID>SRA1643145</PRIMARY_ID><SUBMITTER_ID namespace="University of Miami">SUB13452385</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Miami</Name><Contact email="agriswold@med.miami.edu"><Address><Street>1501 NW 10th Ave, BRB 318</Street